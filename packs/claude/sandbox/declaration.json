{
  "schema": "ataniq.pack-declaration/1",
  "builds": {
    "2.1.332": {
      "binds": [
        {
          "role": "provider-policy",
          "kind": "file",
          "inside": "/etc/claude-code/managed-settings.json"
        },
        {
          "role": "config-overlay",
          "kind": "file",
          "inside": "/home/lead/.claude/settings.json"
        },
        {
          "role": "config-overlay",
          "kind": "file",
          "inside": "/home/lead/.claude/settings.local.json"
        },
        {
          "role": "config-overlay",
          "kind": "folder",
          "inside": "/home/lead/.claude/agents"
        },
        {
          "role": "config-overlay",
          "kind": "folder",
          "inside": "/home/lead/.claude/plugins"
        },
        {
          "role": "tree-overlay",
          "kind": "folder",
          "inside": ".claude"
        },
        {
          "role": "session-store",
          "kind": "folder",
          "inside": "/home/lead/.claude/projects"
        }
      ],
      "launch": {
        "argv": [
          "claude",
          "--permission-mode={permission_mode}",
          "--strict-mcp-config",
          "--agent={agent}",
          "--effort={effort}",
          "--resume={resume}",
          "--model={model}"
        ],
        "grammars": {
          "model": "^[a-z][a-z0-9.-]{0,63}$",
          "effort": "^(low|medium|high|xhigh|max)$"
        },
        "permission_modes": [
          {
            "name": "acceptEdits"
          },
          {
            "name": "auto"
          },
          {
            "name": "bypassPermissions"
          },
          {
            "name": "dontAsk"
          },
          {
            "name": "manual"
          },
          {
            "name": "plan"
          }
        ],
        "agents": [
          {
            "name": "reviewer",
            "definition": "/home/lead/.claude/agents/reviewer.md"
          }
        ],
        "env": {
          "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
          "DISABLE_TELEMETRY": "1"
        }
      }
    }
  }
}