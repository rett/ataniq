# Owner-local /etc/authority-host/seat/seat.env (root-owned, mode 0600).
# Replace the placeholders with the gate's IP address, port and pin file.
SEAT_GATE_ARGS="--gate-entry first,203.0.113.20:GATEPORT,/etc/authority-host/seat/gate.pin"

# For two gates, replace the assignment above with one line containing both.
# SEAT_GATE_ARGS="--gate-entry first,203.0.113.20:GATEPORT,/etc/authority-host/seat/gate.pin --gate-entry second,ADDR:PORT,/etc/authority-host/seat/second.pin"
# Leave SEAT_NOTIFY_ARGS empty or absent with any --gate-entry.
