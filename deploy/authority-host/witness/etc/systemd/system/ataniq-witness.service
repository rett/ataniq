# The switch starts this decision service under its inhibit.
[Unit]
Description=Authority host checkpoint witness
After=network.target

[Service]
Type=exec
User=ataniq-witness
Group=ataniq-witness
ExecStartPre={release}/bin/ataniq-witness check --config /etc/authority-host/witness/config.json
ExecStart={release}/bin/ataniq-witness run --config /etc/authority-host/witness/config.json
Restart=on-failure
RestartSec=5s
RuntimeDirectory=ataniq-witness
RuntimeDirectoryMode=0700
StateDirectory=ataniq-witness
StateDirectoryMode=0700
UMask=0077

# IPAddressAllow grants the home address on every port. Only the owner's
# nftables output rules restrict the witness to the configured TCP port.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
SocketBindDeny=any

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
MemoryMax=256M
TasksMax=64
