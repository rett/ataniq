# The witness overlay extends the composed seat and notifier commands.
# The commands that stop the decision services, run by ah-switch when no
# healthy release is left and for the release a switch goes back from (see
# ../README.md, "Layout"). The static status page stays.
systemctl stop ataniq-seat.service
systemctl stop ataniq-seat-notify.service
# Stop the witness along with the other decision services.
systemctl stop ataniq-witness.service
