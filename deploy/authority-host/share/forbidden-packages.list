# Packages the authority host never needs, read by ah-noaicheck (see
# ../README.md). One package name per line; blank lines and lines starting
# with '#' are ignored. An installed package named here is a hit even while
# packages.allow is empty; the package allowlist is the real control, this
# list only makes the worst cases fail before it is filled.

# Names are matched exactly, so every series of a family is named: the
# names are those of the Arch core and extra repositories (each nodejs-lts-*
# provides nodejs but is installed under its own name).

# Runtimes and package managers that install agent tools.
nodejs
nodejs-lts-iron
nodejs-lts-jod
nodejs-lts-krypton
npm
pnpm
yarn
bun
bun-bin
deno
mise
mise-bin
uv
python-pipx
pipx
python-pip
cargo
rust
rustup
go

# Local model runtimes, with their accelerator variants.
ollama
ollama-cuda
ollama-rocm
ollama-vulkan
