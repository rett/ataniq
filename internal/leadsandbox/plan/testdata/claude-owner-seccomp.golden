--ro-bind /opt/ataniq/git/arc-lead/config /ataniq/git/config
--bind /state/leads/arc-lead/tree /work/demo
--ro-bind /state/leads/arc-lead/tree/.git/config /work/demo/.git/config
--ro-bind /state/leads/arc-lead/tree/.git/hooks /work/demo/.git/hooks
--ro-bind /state/leads/arc-lead/tree/.git/info /work/demo/.git/info
--ro-bind /state/mirrors/demo.git /ataniq/mirror/demo.git
--ro-bind /opt/ataniq/qargi /ataniq/qargi
--ro-bind /opt/ataniq/assignment/demo /ataniq/assignment
--ro-bind /opt/ataniq/projection/demo /ataniq/projection
--chdir /work/demo
--remount-ro /
--
# inner
/ataniq/probe --spec /ataniq/spec/spec.json -- /ataniq/agent/bin/claude --model example
# env
CLAUDE_CONFIG_DIR=/home/lead/.claude
COLORTERM=truecolor
GIT_CEILING_DIRECTORIES=/work
GIT_CONFIG_GLOBAL=/ataniq/git/config
GOCACHE=/home/lead/.cache/go-build
GOMODCACHE=/home/lead/go/pkg/mod
HOME=/home/lead
LANG=C.UTF-8
LOGNAME=owner
PATH=/ataniq/qargi/bin:/ataniq/agent/bin:/usr/local/bin:/usr/bin:/bin:/home/lead/.local/bin
QARGI_LEAD=arc-lead
SHELL=/bin/bash
TERM=xterm-256color
TMPDIR=/tmp
TZ=UTC
